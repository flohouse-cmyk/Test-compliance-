# Best Finds Under $100 — environment variables
# ALL of these are OPTIONAL. The app runs fully in demo mode with none of them.
# In Replit, add these as Secrets (Tools → Secrets) instead of a .env file.

# AI-enhanced voiceover writing (falls back to built-in templates without it)
OPENAI_API_KEY=

# Add after you're approved for Amazon Associates.
# When set, Amazon search links automatically include your tag.
AMAZON_ASSOCIATE_TAG=

# Add after you have TikTok developer/Shop access.
TIKTOK_ACCESS_TOKEN=

# Add after you set up YouTube Data API access.
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Add after you have a Pinterest developer token.
PINTEREST_ACCESS_TOKEN=

# Flask session secret (any random string; optional for local use)
SECRET_KEY=

# Optional: custom SQLite location (defaults to ./bestfinds.db)
# DATABASE_PATH=
